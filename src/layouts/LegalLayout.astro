---
import BaseLayout from './BaseLayout.astro';
import '../styles/legal.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
  lastUpdated: string;
  downloadUrl: string;
  toc: { id: string; label: string }[];
  breadcrumbName: string;
  tagLabel: string;
  lang?: 'fr' | 'en';
}

const {
  title,
  description,
  canonical,
  lastUpdated,
  downloadUrl,
  toc,
  breadcrumbName,
  tagLabel,
  lang = 'fr',
} = Astro.props;

const T = {
  fr: {
    back: '← Retour à l’accueil',
    lastUpdated: 'Dernière mise à jour :',
    download: 'Télécharger en PDF',
    toc: 'Sommaire',
    tocAria: 'Sommaire',
    footerAria: 'Autres documents légaux',
    homeName: 'Accueil',
    homeHref: '/',
    links: {
      mentions: { href: '/mentions-legales', label: 'Mentions légales' },
      cgu: { href: '/cgu', label: 'CGU' },
      privacy: { href: '/politique-de-confidentialite', label: 'Politique de confidentialité' },
      contact: { href: '/contact', label: 'Contact' },
    },
  },
  en: {
    back: '← Back to home',
    lastUpdated: 'Last updated:',
    download: 'Download as PDF',
    toc: 'Table of contents',
    tocAria: 'Table of contents',
    footerAria: 'Other legal documents',
    homeName: 'Home',
    homeHref: '/en/',
    links: {
      mentions: { href: '/en/mentions-legales', label: 'Legal notice' },
      cgu: { href: '/en/cgu', label: 'Terms' },
      privacy: { href: '/en/politique-de-confidentialite', label: 'Privacy policy' },
      contact: { href: '/contact', label: 'Contact' },
    },
  },
}[lang];

const seoLocale = lang === 'en' ? 'en_US' : 'fr_FR';
const altLocale = lang === 'en' ? 'fr_FR' : 'en_US';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: T.homeName,
      item: `https://www.gofusion.fr${T.homeHref}`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: breadcrumbName,
      item: `https://www.gofusion.fr${canonical}`,
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={breadcrumb}
  locale={seoLocale}
  alternateLocale={altLocale}
>
  <main class="legal-page">
    <div class="legal-container">
      <a href={T.homeHref} class="legal-back">{T.back}</a>

      <div class="legal-tag">{tagLabel}</div>

      <div class="legal-meta" role="complementary">
        <div class="legal-meta-info">
          <span><strong>{T.lastUpdated}</strong> {lastUpdated}</span>
          <span>Oudavone SAS · 58 rue Monceau · 75008 Paris</span>
        </div>
        <a href={downloadUrl} class="legal-download" download>
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          {T.download}
        </a>
      </div>

      {
        toc.length > 0 && (
          <nav class="legal-toc" aria-label={T.tocAria}>
            <h2>{T.toc}</h2>
            <ol>
              {toc.map((item) => (
                <li>
                  <a href={`#${item.id}`}>{item.label}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <article class="legal-content">
        <slot />
      </article>

      <nav class="legal-footer-nav" aria-label={T.footerAria}>
        <a href={T.links.mentions.href}>{T.links.mentions.label}</a>
        <a href={T.links.cgu.href}>{T.links.cgu.label}</a>
        <a href={T.links.privacy.href}>{T.links.privacy.label}</a>
        <a href={T.links.contact.href}>{T.links.contact.label}</a>
      </nav>
    </div>
  </main>
</BaseLayout>
