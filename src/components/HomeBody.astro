    {n:3, title:"La souveraineté : un mardi matin, votre IA disparaît", meta:"27 août 2026 · 3 min", file:"ep-03-Un-mardi-matin-IA-disparait", desc:"Le 12 juin, deux des plus gros modèles ont été coupés 19 jours. Une IA par API est un service, pas une possession."},
    {n:4, title:"La sobriété : le plus petit modèle qui suffit", meta:"27 août 2026 · 2 min", file:"ep-04-Le-plus-petit-modele", desc:"La bonne question n'est pas « quel est le plus gros modèle ? » mais « quel est le plus petit qui fait le travail ? »."},
    {n:5, title:"Le cas d'usage le plus chiant", meta:"27 août 2026 · 3 min", file:"ep-05-Cas-usage-le-plus-chiant", desc:"Prenez le plus ennuyeux : répétitif, sans variation, ingrat. Et invitez ceux qui font la tâche tous les jours, pas seulement les managers."},
    {n:6, title:"L'objection : « on n'est pas prêts »", meta:"27 août 2026 · 3 min", file:"ep-06-Rater-le-train-de-IA", desc:"Data, compétences, sécurité, conformité : cinq raisons d'attendre. Se lancer ne veut pas dire foncer, ça veut dire réduire la taille du pari."},
    {n:7, title:"La preuve : 2 agents, 700 dossiers", meta:"27 août 2026 · 3 min", file:"ep-07-Deux-agents-700-dossiers", desc:"L'agent prend le répétitif (accuser réception, classer, relancer) ; l'humain garde la décision et la relation. Le temps gagné, ils le rendent aux usagers."},
    {n:9, title:"La carte de la souveraineté : les 5 couches", meta:"27 août 2026 · 3 min", file:"ep-09-Les-5-couches", desc:"Une chaîne IA, c'est cinq couches : puces, cloud, modèle, passerelle, applications métier. Une seule vous échappe. Les quatre autres dépendent de vos choix."},
    {n:10, title:"La bascule : 70 % de modèles chinois", meta:"27 août 2026 · 2 min", file:"ep-10-70-pourcent-modeles-chinois", desc:"En un an, la part des modèles chinois utilisés est passée d'environ 30 % à 70 %. Choisir un modèle, c'est choisir un risque."},
    {n:11, title:"La polémique Mistral", meta:"27 août 2026 · 3 min", file:"ep-11-Mistral-modeles-chinois", desc:"Mistral met en avant un modèle chinois open weight, mais sur SON infrastructure, sans le modifier. La vraie question : qui contrôle l'environnement ?"},
    {n:12, title:"L'oubli qui coûte des semaines : les API externes", meta:"27 août 2026 · 3 min", file:"ep-12-Les-API-externes", desc:"Votre agent va devoir se connecter à vos outils. Les prestataires extérieurs sont le délai que personne ne met dans le planning."}
  ];
  const epGrid = document.getElementById('fusEpGrid');
  if(epGrid){
    epGrid.innerHTML = episodes.map(e => `
      <div class="fus-episode">
        <div class="fus-ep-thumb" data-video="${VIDEO_BASE}/${e.file}.mp4">
          <img src="${POSTER_BASE}/${e.file}.jpg" alt="Épisode ${e.n}" loading="lazy">
          <div class="fus-ep-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
          <div class="fus-ep-num">ÉPISODE ${e.n}</div>
        </div>
        <div class="fus-ep-body">
          <div class="fus-ep-meta">${e.meta}</div>
          <h3 class="fus-ep-title">${e.title}</h3>
          <p class="fus-ep-desc">${e.desc}</p>
        </div>
      </div>
    `).join('');
    epGrid.addEventListener('click', ev => {
      const thumb = ev.target.closest('.fus-ep-thumb');
      if(!thumb) return;
      const vid = document.createElement('video');
      vid.src = thumb.dataset.video;
      vid.controls = true;
      vid.autoplay = true;
      vid.className = 'fus-ep-video';
      thumb.parentElement.replaceChild(vid, thumb);
    });
  }
  const podList = document.getElementById('fusPodList');
  if(podList){
    podList.innerHTML = episodes.map(e => `
      <div class="fus-podcast-item">
        <div class="fus-pod-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
        <div class="fus-pod-info">
          <div class="fus-pod-num">Épisode ${e.n} · ${e.meta}</div>
          <div class="fus-pod-title">${e.title}</div>
          <div class="fus-pod-meta">${e.desc.slice(0,90)}…</div>
        </div>
        <div class="fus-pod-audio"><audio controls preload="none" src="${VIDEO_BASE}/${e.file}.mp4"></audio></div>
      </div>
    `).join('');
  }
  document.querySelectorAll('.fus-blog-tab').forEach(t => t.addEventListener('click', ev => {
    document.querySelectorAll('.fus-blog-tab').forEach(x => x.classList.remove('active'));
    document.querySelectorAll('.fus-tab-panel').forEach(x => x.classList.remove('active'));
    ev.target.classList.add('active');
    document.querySelector(`.fus-tab-panel[data-panel="${ev.target.dataset.tab}"]`).classList.add('active');
  }));
})();
</script>
