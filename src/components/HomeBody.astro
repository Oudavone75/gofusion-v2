  const episodes = [
    {n:1, title:"L'AI Act, en 3 mots", meta:"27 août 2026 · 2 min", file:"ep-01-Trois-regles-de-l-IA-Act", desc:"Tracer, décider, former. Chaque action d'un agent doit être retraçable, l'IA éclaire mais l'humain tranche, et la conformité passe par des équipes qui comprennent l'outil."},
    {n:2, title:"Le constat terrain", meta:"27 août 2026 · 3 min", file:"ep-02-Les-elus-disent-oui", desc:"« On veut de l'IA. » L'envie des élus est réelle. Mais trois questions restent souvent sans réponse : quel cas d'usage précis, quel retour attendu, qui pilote ?"},
    {n:3, title:"La souveraineté : un mardi matin, votre IA disparaît", meta:"27 août 2026 · 3 min", file:"ep-03-Un-mardi-matin-IA-disparait", desc:"Le 12 juin, deux des plus gros modèles ont été coupés 19 jours. Une IA par API est un service, pas une possession."},
