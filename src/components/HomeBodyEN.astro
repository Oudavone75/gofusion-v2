    epGrid.innerHTML = episodes.map(e => `
      <div class="fus-episode">
        <div class="fus-ep-thumb" data-video="${VIDEO_BASE}/${e.file}.mp4">
          <img src="${POSTER_BASE}/${e.file}.jpg" alt="Episode ${e.n}" loading="lazy">
          <div class="fus-ep-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
          <div class="fus-ep-num">EPISODE ${e.n}</div>
        </div>
        <div class="fus-ep-body">
          <div class="fus-ep-meta">${e.meta}</div>
          <h3 class="fus-ep-title">${e.title}</h3>
          <p class="fus-ep-desc">${e.desc}</p>
        </div>
      </div>
    `).join('');
    epGrid.addEventListener('click', ev => {
      const thumb = ev.target.closest('.fus-ep-thumb');
      if(!thumb) return;
      const vid = document.createElement('video');
      vid.src = thumb.dataset.video;
      vid.controls = true;
      vid.autoplay = true;
      vid.className = 'fus-ep-video';
      thumb.parentElement.replaceChild(vid, thumb);
    });
  }
  const podList = document.getElementById('fusPodListEN');
  if(podList){
    podList.innerHTML = episodes.map(e => `
      <div class="fus-podcast-item">
        <div class="fus-pod-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
        <div class="fus-pod-info">
          <div class="fus-pod-num">Episode ${e.n} · ${e.meta}</div>
          <div class="fus-pod-title">${e.title}</div>
          <div class="fus-pod-meta">${e.desc.slice(0,90)}…</div>
        </div>
        <div class="fus-pod-audio"><audio controls preload="none" src="${VIDEO_BASE}/${e.file}.mp4"></audio></div>
      </div>
    `).join('');
  }
  document.querySelectorAll('.fus-blog-tab').forEach(t => t.addEventListener('click', ev => {
    document.querySelectorAll('.fus-blog-tab').forEach(x => x.classList.remove('active'));
    document.querySelectorAll('.fus-tab-panel').forEach(x => x.classList.remove('active'));
    ev.target.classList.add('active');
    document.querySelector(`.fus-tab-panel[data-panel="${ev.target.dataset.tab}"]`).classList.add('active');
  }));
})();
</script>
