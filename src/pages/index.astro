---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeBody from '../components/HomeBody.astro';
import { SITE } from '../consts';

const title = "Fusion | Agents IA + adoption pour entreprises et collectivités";
const description =
  "Agents Fusion crée vos agents IA métier. Go Fusion les fait adopter par vos équipes. Hébergement en France (Mistral via Scaleway, ISO 27001), sous droit français. Incubé Station F. Pour entreprises et collectivités.";

const softwareAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Go Fusion',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web, iOS, Android',
  offers: {
    '@type': 'Offer',
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.8',
    reviewCount: '42',
  },
  featureList: [
    'Contenu généré par IA',
    'Application mobile iOS et Android',
    'Dashboard temps réel',
    'Gamification des apprentissages',
    'Conforme IA Act',
    'Déploiement en 1 semaine',
  ],
  provider: { '@id': `${SITE.url}/#organization` },
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE.url}/` },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: "Comment déployer des agents IA en entreprise ?",
      acceptedAnswer: {
        '@type': 'Answer',
        text: "On commence par un audit de vos process métier pour identifier les tâches à fort volume et faible valeur ajoutée (standard, prospection, comptabilité, juridique…). On co-conçoit ensuite un agent IA taillé pour votre entreprise, testé sur vos vrais dossiers avant déploiement. Comptez 2 à 4 semaines de la décision à la mise en production, avec vos équipes qui gardent la décision finale.",
      },
    },
    {
      '@type': 'Question',
      name: "Qu'est-ce qu'un agent IA métier concrètement ?",
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Un agent IA métier est un logiciel qui exécute une tâche répétitive à la place de vos équipes : accuser réception d'un dossier, extraire les informations d'un formulaire, rédiger un premier jet de courrier, analyser un contrat, produire un rapport. Il travaille au bon format, à volume, sans jugement propre. L'humain valide et décide.",
      },
    },
    {
      '@type': 'Question',
      name: "Combien coûte un agent IA sur mesure ?",
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Nos tarifs dépendent du périmètre : un agent simple mono-tâche démarre à quelques milliers d'euros par mois, un déploiement multi-agents avec plateforme d'adoption Go Fusion se calcule au projet. On vous fait toujours un devis après l'audit gratuit. Contactez-nous à contact@gofusion.fr pour discuter de votre cas.",
      },
    },
    {
      '@type': 'Question',
      name: "Comment former mes équipes à utiliser l'IA ?",
      acceptedAnswer: {
        '@type': 'Answer',
        text: "C'est exactement ce que fait Go Fusion, notre plateforme de formation gamifiée. Des défis de 3 minutes par jour, un coach IA en mise en situation (pitch, négociation, onboarding), et une adoption mesurée dans le temps. Livré avec chaque déploiement d'agents IA, disponible aussi seul pour former sur des thématiques transverses (RSE, cybersécurité, QVT, conformité, produit).",
      },
    },
    {
      '@type': 'Question',
      name: "L'IA Act oblige-t-il à former les collaborateurs ?",
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Oui. Depuis février 2025, l'article 4 de l'IA Act européen oblige les entreprises à garantir un niveau suffisant de maîtrise de l'IA (AI literacy) pour tous les collaborateurs qui déploient ou utilisent un système d'IA. Ce n'est pas juste pour les équipes techniques. Go Fusion couvre cette obligation avec des parcours conformes IA Act, traçables et documentés.",
      },
    },
    {
      '@type': 'Question',
      name: "Comment garantir la protection des données ?",
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Vos données sont hébergées en France chez Scaleway (ISO 27001, HDS), sous droit français. Les modèles d'IA sont Mistral, éditeur français. Aucun transfert de données hors UE. Conformité RGPD, chiffrement AES-256, purge automatique 12 mois après collecte. Chaque utilisateur peut demander la suppression de ses données à tout moment.",
      },
    },
    {
      '@type': 'Question',
      name: "Que veut dire souverain pour Fusion ?",
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Nous parlons de souveraineté au sens juridique et opérationnel : vos données restent hébergées en France chez Scaleway (ISO 27001, HDS, SecNumCloud en cours de qualification), opérées sous droit français, avec des modèles Mistral (éditeur français). Aucune donnée ne transite hors UE et nous ne sommes pas soumis au CLOUD Act américain. En revanche, nous ne prétendons pas à une souveraineté matérielle absolue (semi-conducteurs, équipements réseau) : à ce jour, aucun acteur au monde ne peut la revendiquer sur toute la chaîne. Nous préférons vous le dire clairement plutôt que de vendre du rêve.",
      },
    },
    {
      '@type': 'Question',
      name: "En combien de temps peut-on déployer un agent IA ?",
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Pour un agent standard (standard téléphonique, réponse mail L1, extraction de formulaire) : 2 à 3 semaines de l'audit à la mise en production. Pour un agent métier plus complexe (juridique, comptabilité, marchés publics) : 4 à 8 semaines. La plateforme Go Fusion, elle, est opérationnelle en 1 semaine.",
      },
    },
    {
      '@type': 'Question',
      name: "Quelle différence entre Agents Fusion et Go Fusion ?",
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Agents Fusion = les agents IA qui font le travail (exécution de tâches métier). Go Fusion = la plateforme qui forme et engage vos équipes pour qu'elles pilotent vraiment ces agents (adoption). Les deux ensemble transforment un projet IA en résultats concrets. On peut acheter les deux ensemble, ou Go Fusion seul pour vos formations internes.",
      },
    },
    {
      '@type': 'Question',
      name: "Qu'est-ce que Go Fusion exactement ?",
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Go Fusion est une plateforme de gamification qui transforme n'importe quel sujet, avantages RH, intelligence artificielle, cybersécurité, RSE, soft skills, en parcours de micro-défis interactifs de 3 minutes. Le contenu (quiz, vidéos, podcasts, défis photo) est généré par IA, validé par vos équipes, et déployable en 1 semaine.",
      },
    },
    {
      '@type': 'Question',
      name: 'À qui s\'adresse Go Fusion ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Go Fusion s'adresse aux entreprises (RH, communication interne, formation), aux collectivités territoriales (engagement citoyen, plan climat, démocratie participative), aux établissements scolaires (sensibilisation, entrepreneuriat) et aux organisateurs d'événements (salons, séminaires). L'application est gratuite pour les utilisateurs finaux.",
      },
    },
    {
      '@type': 'Question',
      name: 'Comment fonctionne la création de contenu par IA ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "L'IA analyse votre stratégie, vos documents et vos priorités pour générer automatiquement des quiz, défis vidéo, podcasts et micro-formations. Aucune donnée personnelle n'est transmise à l'IA. Tout le contenu est systématiquement relu et validé par Go Fusion puis par vous avant diffusion. Vos collaborateurs peuvent aussi remonter leurs bonnes pratiques terrain, que l'IA transforme en contenu de formation.",
      },
    },
    {
      '@type': 'Question',
      name: 'Combien de temps faut-il pour déployer Go Fusion ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "De la décision au lancement, comptez 1 semaine. Go Fusion prend en charge la création de contenu, votre charge de travail est de 1 journée maximum. Vous recevez un kit de mise en marche complet : templates de communication, guide ambassadeur, FAQ et assets visuels à vos couleurs.",
      },
    },
    {
      '@type': 'Question',
      name: 'Go Fusion est-il disponible sur mobile et web ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Oui, Go Fusion est disponible en application mobile native sur iOS et Android avec un parcours type Duolingo, ainsi qu'en web app accessible depuis n'importe quel navigateur. La plateforme s'intègre directement dans vos outils du quotidien, Microsoft Teams, Slack, intranet, pour une expérience totalement fluide sans changer les habitudes de vos équipes.",
      },
    },
    {
      '@type': 'Question',
      name: 'Quels types de campagnes peut-on lancer ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Go Fusion propose un catalogue de campagnes prêtes à l'emploi sur les sujets clés : intelligence artificielle et IA Act, cybersécurité, climat et RSE, avantages salariés, soft skills et reconnaissance, handicap et inclusion, bien-être et QVT, onboarding. Chaque campagne est 100% personnalisable à votre image et contexte.",
      },
    },
    {
      '@type': 'Question',
      name: 'Comment mesure-t-on l\'engagement et les résultats ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Go Fusion fournit un dashboard temps réel avec les indicateurs clés : taux de participation, progression des équipes, feedback terrain, et classements. En moyenne, Go Fusion permet d'économiser 20 jours par an et par collaborateur car les formations sont intégrées dans le quotidien. Un rapport de fin de campagne est généré pour présenter l'impact en comité de direction.",
      },
    },
    {
      '@type': 'Question',
      name: 'Les données des utilisateurs sont-elles protégées ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Oui, Go Fusion est conforme au RGPD. Les données sont hébergées en France, chez Scaleway (datacenters français, certifié ISO/IEC 27001) : aucune donnée ne quitte le territoire national. Le modèle d'IA utilisé pour générer le contenu est Mistral, consommé via Scaleway ; il ne reçoit aucune donnée personnelle ni aucune information confidentielle, uniquement des consignes thématiques génériques. Aucune donnée personnelle n'est transmise à des tiers. Les données sont chiffrées (AES-256) et purgées automatiquement 12 mois après leur collecte. Chaque utilisateur peut demander la suppression de ses données à tout moment.",
      },
    },
    {
      '@type': 'Question',
      name: 'Quel est le coût de Go Fusion ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "L'application est gratuite pour les utilisateurs finaux (collaborateurs, étudiants, citoyens). Le financement est assuré par les entreprises, collectivités ou établissements qui déploient la solution. Contactez-nous à contact@gofusion.fr pour une offre adaptée.",
      },
    },
    {
      '@type': 'Question',
      name: 'Peut-on utiliser Go Fusion pour l\'engagement citoyen ?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Absolument. Go Fusion permet aux collectivités de transformer leur Plan Climat en expérience interactive, de lancer des sondages et votes gamifiés, de sensibiliser aux éco-gestes et à la mobilité douce, et de former les agents sur la cybersécurité. Les citoyens n'ont pas besoin de code d'accès pour participer.",
      },
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonical="/"
  jsonLd={[
    softwareAppSchema,
    breadcrumb,
    faqSchema,
    {
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: 'Agents Fusion',
      serviceType: "Agents IA métier sur mesure pour entreprises et collectivités",
      description:
        "Conception et déploiement d'agents IA métier sur mesure : standard téléphonique 24/7, prospection commerciale, rédaction éditoriale, juridique, comptabilité, urbanisme, logement social. Audit process + déploiement en quelques semaines. Hébergement en France chez Scaleway (ISO 27001, HDS, SecNumCloud en cours), modèles Mistral, sous droit français.",
      areaServed: ['FR', 'BE', 'LU', 'CH'],
      provider: { '@id': `${SITE.url}/#organization` },
      audience: { '@type': 'Audience', audienceType: 'Entreprises, ETI, PME, grands groupes, collectivités territoriales' },
      offers: { '@type': 'Offer', priceCurrency: 'EUR', availability: 'https://schema.org/InStock' },
      brand: { '@type': 'Brand', name: 'Fusion' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: 'Go Fusion',
      serviceType: "Plateforme de formation gamifiée par l'IA",
      description:
        "Plateforme SaaS de micro-learning gamifié : défis de 3 minutes par jour, coach IA en mise en situation, adoption mesurée. Conforme IA Act (article 4 sur l'AI literacy). Livrée avec chaque déploiement d'agents IA, disponible aussi en autonomie pour la formation interne sur thématiques transverses (RSE, cybersécurité, QVT, conformité, onboarding, produit).",
      areaServed: ['FR', 'BE', 'LU', 'CH', 'DE'],
      provider: { '@id': `${SITE.url}/#organization` },
      audience: { '@type': 'Audience', audienceType: 'RH, formation, communication interne, direction' },
      offers: { '@type': 'Offer', priceCurrency: 'EUR', availability: 'https://schema.org/InStock' },
      brand: { '@type': 'Brand', name: 'Fusion' },
    },
  ]}
>
  <link slot="head" rel="stylesheet" href="/home.css" />
  <HomeBody />
</BaseLayout>
