---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';

const title = 'Public sector, Fusion Agents for local authorities';
const description =
  "AI agents for local authorities: Mayor's Office, planning, social housing, procurement, legal, finances. French sovereignty, Station F incubated.";

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/en/` },
    { '@type': 'ListItem', position: 2, name: 'Public sector', item: `${SITE.url}/en/local-authorities` },
  ],
};
---

<BaseLayout title={title} description={description} canonical="/en/local-authorities" locale="en_US" alternateLocale="fr_FR" jsonLd={[breadcrumb]}>
  <link slot="head" rel="stylesheet" href="/home.css" />

  <nav><div class="inner"><a href="/en/" class="fus-nav-logo"><img src="/assets/logos/logo-fusion.png" alt="Fusion" class="fus-logo-img" width="44" height="44">Fusion</a><ul><li><a href="/en/#solution">Our solution</a></li><li><a href="/en/#usecases">Use Cases</a></li><li><a href="/en/local-authorities" style="color:var(--teal-bright,#00E5D0)">Public sector</a></li><li><a href="/en/#blog">Blog</a></li><li><a href="/collectivites" class="lang-switch">FR</a></li><li><a href="https://mon.gofusion.fr/connexion" class="nav-cta nav-play" target="_blank" rel="noopener"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg> Play</a></li><li><a href="mailto:contact@gofusion.fr" class="nav-cta">Demo</a></li></ul></div></nav>

  <section class="fus-hero" style="padding:120px 0 40px">
    <div class="fus-hero-content">
      <div class="fus-eyebrow"><span class="dot"></span> Dedicated offer · Public sector</div>
      <h1>AI agents <span class="brand-a">for the whole authority.</span></h1>
      <p class="fus-hero-sub">A dedicated offer for elected officials, and business agents for your services: planning, social housing, procurement, finances, legal. <strong style="color:#fff">Each one executes, you validate.</strong> None decides in your place.</p>
    </div>
  </section>

  <section class="fus-section-cream" style="padding:80px 0">
    <div class="container" style="text-align:center;max-width:820px">
      <div class="fus-section-tag"><span class="line"></span> LEARN MORE <span class="line"></span></div>
      <h2 class="fus-section-title" style="margin-bottom:20px">Our public sector offer has a <em>dedicated site.</em></h2>
      <p class="fus-section-sub" style="margin:0 auto 32px;font-size:18px">Find agent details, real cases for elected officials and services, pricing and integrations on <strong>agentsfusion.fr</strong>.</p>
      <a href="https://agentsfusion.fr" target="_blank" rel="noopener" class="btn-primary" style="display:inline-flex;align-items:center;gap:10px;padding:16px 34px;font-size:16px">Discover agentsfusion.fr →</a>
      <p style="margin-top:20px;font-size:13px;color:rgba(10,22,40,.5)">Opens in a new tab · Partner site of the Fusion brand</p>
    </div>
  </section>
</BaseLayout>
